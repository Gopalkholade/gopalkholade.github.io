---
interface Props {
  skills: {
    languages: string[];
    dataAnalytics: string[];
    aiAndML: string[];
    toolsAndCloud: string[];
  };
}

const { skills } = Astro.props;
---
<section id="skills" class="mb-20">
  <!-- Section Header -->
  <div class="flex items-center justify-between mb-8 pb-3 border-b border-stroke">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-accent-cyan">02.</span>
      <h2 class="text-xs font-mono tracking-widest text-text-dim uppercase">
        Technical Stack &amp; Tooling
      </h2>
    </div>
    <span class="text-[11px] font-mono text-text-dim hidden sm:inline">
      verified via production repos &amp; pipelines
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Languages & Engines -->
    <div class="p-5 rounded-lg border border-stroke bg-panel shadow-card-subtle">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-mono text-xs text-text-main font-semibold flex items-center gap-2">
          <span class="text-accent-cyan">&gt;</span> Languages &amp; Query Engines
        </h3>
        <span class="text-[10px] font-mono text-accent-cyan bg-accent-cyan-dim px-2 py-0.5 rounded border border-accent-cyan/20">
          Core
        </span>
      </div>
      <p class="text-xs text-text-dim mb-3">Primary drivers for data manipulation, scripts, and analytical workflows.</p>
      <div class="flex flex-wrap gap-1.5">
        {skills.languages.map(s => (
          <span class="text-xs font-mono px-2.5 py-1 bg-surface border border-stroke rounded text-text-muted hover:text-text-main transition-colors">
            {s}
          </span>
        ))}
      </div>
    </div>

    <!-- Data Pipelines & ETL -->
    <div class="p-5 rounded-lg border border-stroke bg-panel shadow-card-subtle">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-mono text-xs text-text-main font-semibold flex items-center gap-2">
          <span class="text-accent-cyan">&gt;</span> Data Engineering &amp; Analytics
        </h3>
        <span class="text-[10px] font-mono text-accent bg-accent-dim px-2 py-0.5 rounded border border-accent/20">
          Production
        </span>
      </div>
      <p class="text-xs text-text-dim mb-3">Automated extraction, schema reconciliation, and operational BI.</p>
      <div class="flex flex-wrap gap-1.5">
        {skills.dataAnalytics.map(s => (
          <span class="text-xs font-mono px-2.5 py-1 bg-surface border border-stroke rounded text-text-muted hover:text-text-main transition-colors">
            {s}
          </span>
        ))}
      </div>
    </div>

    <!-- Applied AI & ML -->
    <div class="p-5 rounded-lg border border-stroke bg-panel shadow-card-subtle">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-mono text-xs text-text-main font-semibold flex items-center gap-2">
          <span class="text-accent">&gt;</span> Applied AI &amp; Machine Learning
        </h3>
        <span class="text-[10px] font-mono text-accent bg-accent-dim px-2 py-0.5 rounded border border-accent/20">
          Active R&amp;D
        </span>
      </div>
      <p class="text-xs text-text-dim mb-3">Predictive modeling, parameter-efficient fine-tuning, and RAG pipelines.</p>
      <div class="flex flex-wrap gap-1.5">
        {skills.aiAndML.map(s => (
          <span class="text-xs font-mono px-2.5 py-1 bg-surface border border-stroke rounded text-text-muted hover:text-text-main transition-colors">
            {s}
          </span>
        ))}
      </div>
    </div>

    <!-- Dev Tools & Environments -->
    <div class="p-5 rounded-lg border border-stroke bg-panel shadow-card-subtle">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-mono text-xs text-text-main font-semibold flex items-center gap-2">
          <span class="text-accent-cyan">&gt;</span> Tooling &amp; Infrastructure
        </h3>
        <span class="text-[10px] font-mono text-text-dim bg-code-bg px-2 py-0.5 rounded border border-stroke">
          DevOps
        </span>
      </div>
      <p class="text-xs text-text-dim mb-3">Version control, automated CI/CD runners, and reproducible environments.</p>
      <div class="flex flex-wrap gap-1.5">
        {skills.toolsAndCloud.map(s => (
          <span class="text-xs font-mono px-2.5 py-1 bg-surface border border-stroke rounded text-text-muted hover:text-text-main transition-colors">
            {s}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
