---
interface Props {
  certifications?: Array<string | {
    title: string;
    issuer?: string;
    issueDate?: string;
    credentialUrl?: string;
    category?: string;
  }>;
}

const { certifications = [] } = Astro.props;
const defaultCertificatesUrl = process.env.CERTIFICATES_DRIVE_URL || import.meta.env.CERTIFICATES_DRIVE_URL || '';

// Normalize certification objects
const normalizedCerts = certifications.map((c, index) => {
  if (typeof c === 'string') {
    // Check if issuer is in parentheses e.g. "Title (Issuer)"
    const match = c.match(/^(.*?)\s*\((.*?)\)$/);
    if (match) {
      return {
        title: match[1].trim(),
        issuer: match[2].trim(),
        category: match[1].toLowerCase().includes('data') || match[1].toLowerCase().includes('sql') ? 'Data Analytics' : 'Professional Engineering',
        order: index + 1,
        credentialUrl: defaultCertificatesUrl,
      };
    }
    return {
      title: c,
      issuer: 'LinkedIn Learning / Industry Credential',
      category: 'Data & Analytics',
      order: index + 1,
      credentialUrl: defaultCertificatesUrl,
    };
  }
  return {
    title: c.title,
    issuer: c.issuer || 'Verified Credential',
    category: c.category || 'Data Analytics',
    credentialUrl: c.credentialUrl || defaultCertificatesUrl,
    issueDate: c.issueDate,
    order: index + 1
  };
});
---
{normalizedCerts.length > 0 && (
  <section id="certifications" class="mb-20">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-stroke">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-accent-cyan">04.</span>
        <h2 class="text-xs font-mono tracking-widest text-text-dim uppercase">
          Verified Certifications &amp; Credentials
        </h2>
      </div>
      {defaultCertificatesUrl ? (
        <a 
          href={defaultCertificatesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-accent hover:underline inline-flex items-center gap-1.5"
          title="Open complete verified credentials archive on Google Drive"
        >
          <span>Drive Certificate Archive</span>
          <span class="text-[10px]">↗</span>
        </a>
      ) : (
        <span class="text-[11px] font-mono text-text-dim hidden sm:inline">
          continuous skill progression
        </span>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {normalizedCerts.map(cert => (
        <div class="p-4 rounded-lg border border-stroke bg-panel/80 hover:border-stroke-hover transition-all flex flex-col justify-between shadow-card-subtle">
          <div>
            <div class="flex items-center justify-between mb-1.5 font-mono text-[10px]">
              <span class="text-accent-cyan uppercase tracking-wider">
                {cert.category}
              </span>
              <span class="text-text-dim">
                credential #{cert.order}
              </span>
            </div>
            <h3 class="text-sm font-semibold text-text-main leading-snug">
              {cert.title}
            </h3>
            <p class="text-xs font-mono text-text-dim mt-1.5 flex items-center gap-1.5">
              <span class="text-accent text-[11px]">✓</span>
              <span>{cert.issuer}</span>
            </p>
          </div>
          {cert.credentialUrl && (
            <div class="mt-3 pt-2.5 border-t border-stroke/70 flex items-center justify-between">
              <a 
                href={cert.credentialUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-accent-cyan hover:underline inline-flex items-center gap-1"
              >
                <span>View Certificate</span>
                <span class="text-[10px]">↗</span>
              </a>
              <span class="text-[10px] font-mono text-text-dim">drive document</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
)}
