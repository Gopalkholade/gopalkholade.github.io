          <span class="text-[10px]">↗</span>
        </a>

        <a 
          href="https://www.linkedin.com/in/gopalkholade" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-3 py-2 rounded bg-surface border border-stroke hover:border-stroke-hover text-text-muted hover:text-text-main transition-all inline-flex items-center gap-1.5"
        >
          <span>LinkedIn</span>
          <span class="text-[10px]">↗</span>
