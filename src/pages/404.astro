---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Target Not Found">
  <div class="py-24 text-center max-w-md mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-stroke bg-panel font-mono text-xs text-accent-cyan mb-4">
      <span>HTTP 404</span>
      <span class="text-text-dim">·</span>
      <span>ENOENT</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-text-main mb-3">Resource Not Found</h1>
    <p class="text-xs sm:text-sm text-text-muted font-mono mb-8 leading-relaxed">
      The specified route or document does not exist in this static build.
    </p>
    <a 
      href="/" 
      class="px-4 py-2 rounded-md bg-surface border border-stroke hover:border-stroke-hover font-mono text-xs text-text-main hover:text-white transition-all inline-flex items-center gap-1.5"
    >
      <span>← Return to /home</span>
    </a>
  </div>
</Layout>
