---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Certifications from '../components/Certifications.astro';
import { getProjects } from '../lib/firebase';
import profileData from '../data/profile.json';
import experienceData from '../data/experience.json';
import type { Profile, Experience } from '../types';

const profile = profileData as Profile;
const experiences = experienceData as Experience[];
const allProjects = await getProjects();
const featuredProjects = allProjects.filter(p => p.featured).slice(0, 4);
---
<Layout title={`${profile.name} — ${profile.headline}`}>
  <!-- Hero Section with human voice & developer HUD -->
  <Hero profile={profile} />
  
  <!-- Featured Projects -->
  <section id="projects" class="mb-20">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-stroke">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-accent-cyan">01.</span>
        <h2 class="text-xs font-mono tracking-widest text-text-dim uppercase">
          Featured Engineering Case Studies
        </h2>
      </div>
      <a 
        href="/projects" 
        class="text-xs font-mono text-accent-cyan hover:underline inline-flex items-center gap-1"
      >
        <span>All Repositories ({allProjects.length})</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Technical Competencies & Stack -->
  <SkillsMatrix skills={profile.skills} />

  <!-- Experience & Education Timeline -->
  <ExperienceTimeline 
    experiences={experiences} 
    education={profile.education}
  />

  <!-- Verified Certifications -->
  {profile.certifications && profile.certifications.length > 0 && (
    <Certifications certifications={profile.certifications} />
  )}
</Layout>
