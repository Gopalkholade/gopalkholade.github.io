---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/firebase';

const projects = await getProjects();
const dataAnalyticsCount = projects.filter(p => p.category === 'data-analytics').length;
const aiMlCount = projects.filter(p => p.category === 'ai-ml').length;
---
<Layout 
  title="All Technical Projects & Case Studies — Gopal Kholade" 
  description="Explore production data pipelines, automated ETL workflows, predictive modeling pipelines, and applied LLM fine-tuning projects."
>
  <div class="mb-10">
    <div class="flex items-center gap-2 font-mono text-xs text-text-dim mb-3">
      <a href="/" class="hover:text-text-main transition-colors">home</a>
      <span>/</span>
      <span class="text-accent-cyan">projects</span>
      <span class="text-text-dim hidden sm:inline">(all {projects.length} indexed)</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-text-main tracking-tight mb-2">
      Technical Projects &amp; Case Studies
    </h1>
    <p class="text-sm font-mono text-text-muted">
      Production ETL architectures, statistical modeling, and applied AI systems.
    </p>
  </div>

  <!-- Filter tabs -->
  <div class="flex flex-wrap gap-2 mb-8 border-b border-stroke pb-4 font-mono text-xs" id="filter-tabs">
    <button 
      class="px-3 py-1.5 rounded bg-surface border border-stroke text-accent filter-btn active transition-all cursor-pointer" 
      data-filter="all"
    >
      All Projects ({projects.length})
    </button>
    <button 
      class="px-3 py-1.5 rounded border border-transparent text-text-dim hover:text-text-main filter-btn transition-all cursor-pointer" 
      data-filter="data-analytics"
    >
      Data Analytics &amp; Pipelines ({dataAnalyticsCount})
    </button>
    <button 
      class="px-3 py-1.5 rounded border border-transparent text-text-dim hover:text-text-main filter-btn transition-all cursor-pointer" 
      data-filter="ai-ml"
    >
      Applied AI &amp; ML ({aiMlCount})
    </button>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
    {projects.map(project => (
      <div class="project-wrapper" data-category={project.category}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-wrapper') as NodeListOf<HTMLElement>;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('bg-surface', 'border-stroke', 'text-accent');
          b.classList.add('border-transparent', 'text-text-dim');
        });
        btn.classList.add('bg-surface', 'border-stroke', 'text-accent');
        btn.classList.remove('border-transparent', 'text-text-dim');

        const filter = btn.getAttribute('data-filter');
        items.forEach(item => {
          if (filter === 'all' || item.dataset.category === filter) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
